{
  "name": "@agent-company/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:smoke": "node --test test/api.smoke.test.mjs",
    "test": "npm run test:unit && npm run test:smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "5.12.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.71.0",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
