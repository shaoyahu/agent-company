{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/index.ts",
    "src/llm/**/*",
    "src/agent/**/*",
    "src/store/**/*",
    "src/orchestrator/**/*",
    "src/api/**/*",
    "src/config/parser.ts",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*",
    "src/runtime/**/*",
    "src/cli/**/*",
    "src/types.ts",
    "src/config/loader.ts"
  ]
}
