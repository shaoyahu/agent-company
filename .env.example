# Agent Company - 环境变量示例
# 复制为 .env 并填入你的真实 key
# .env 已经在 .gitignore 里,不会进 git

# ─── LLM Providers ───────────────────────────────────
# LLM Agent 必须配置真实 provider；未配置时会明确报错

# Anthropic 官方
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # 可选,默认官方

# OpenAI 官方 / 任意 OpenAI 兼容 endpoint(DeepSeek/Moonshot/通义千问/OpenRouter 都可以)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.moonshot.cn/v1

# ─── Server ───────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ─── Storage ──────────────────────────────────
# 非 Electron Server 的运行态数据目录；留空时使用系统用户数据目录。
# macOS: ~/Library/Application Support/Agent Company
# Linux: ~/.local/share/agent-company
# Windows: %APPDATA%\Agent Company
AGENT_COMPANY_DATA_DIR=
