{
  "name": "@agent-company/electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run typecheck && npm run build:main && npm run build:preload",
    "build:main": "esbuild src/main.ts src/channels.ts src/debug.ts src/ipcHandlers.ts src/lifecycle.ts src/security.ts src/serverHost.ts src/testHooks.ts --outdir=dist --outbase=src --platform=node --format=esm --target=node22 --packages=external --sourcemap",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload.cjs --sourcemap",
    "dev": "node scripts/dev-electron.mjs",
    "install:app-deps": "electron-builder install-app-deps",
    "package:mac": "electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:playwright": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@agent-company/server": "0.1.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.5.0",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "^5.4.0",
    "wait-on": "^9.1.0"
  }
}
